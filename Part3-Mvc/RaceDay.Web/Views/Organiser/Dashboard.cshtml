@model List<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Events</h2>
    <a href="/Organiser/CreateEvent" class="btn btn-primary">+ Create New Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    @if (Model == null || Model.Count == 0)
    {
        <p class="text-muted">You haven't created any events yet.</p>
    }
    else
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    
                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                    {
                        <img src="https://localhost:7040@(ev.BannerUrl)" class="card-img-top" alt="@ev.Name" style="height: 200px; object-fit: cover;">
                    }
                    
                    <div class="card-body">
                        <h5 class="card-title">@ev.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            @(ev.EventDate.Year > 1 ? ev.EventDate.ToString("dd MMM yyyy") : "Date TBA") | @ev.Location
                        </h6>
                        <p class="card-text">@ev.Description</p>
                        <span class="badge bg-info text-dark">@ev.EventType</span>
                        
                        <div class="mt-3">
                            <a href="/Organiser/EventDetails/@ev.EventId" class="btn btn-sm btn-outline-primary w-100">Manage Event</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>