@model RaceDay.Web.Models.EventViewModel
@{
    ViewData["Title"] = "Manage Event";
    var categories = ViewBag.Categories as List<RaceDay.Web.Models.CategoryViewModel> ?? new List<RaceDay.Web.Models.CategoryViewModel>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage: @Model?.Name</h2>
    <div>
        <a href="/Organiser/ViewEnrolments/@Model?.EventId" class="btn btn-info text-white me-2">View Enrolments</a>
        <a href="/Organiser/ResultsEntry/@Model?.EventId" class="btn btn-warning text-dark me-2">Enter Results</a>
        <a href="/Organiser/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-7">
        <h4>Categories</h4>
        <hr />
        
        @if (categories.Count == 0)
        {
            <p class="text-muted">No categories added yet. Add one using the form on the right.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Distance (km)</th>
                        <th>Max Participants</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in categories)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>@cat.DistanceKm km</td>
                            <td>@cat.MaxParticipants</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                Add New Category
            </div>
            <div class="card-body">
                <form asp-action="AddCategory" asp-route-eventId="@Model?.EventId" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. 10km Open" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Distance (km)</label>
                        <input name="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Max Participants</label>
                        <input name="MaxParticipants" class="form-control" type="number" min="1" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100">Add Category</button>
                </form>
            </div>
        </div>
    </div>
</div>