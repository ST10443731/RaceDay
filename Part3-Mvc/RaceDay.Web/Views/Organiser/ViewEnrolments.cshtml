@model List<RaceDay.Web.Models.OrganiserEnrolmentViewModel>
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Enrolments: @ViewBag.EventName</h2>
    <a href="/Organiser/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">No one has enrolled in this event yet.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Participant Name</th>
                <th>Email</th>
                <th>Category</th>
                <th>Enrolment Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Participant</td>
                    <td>@item.ParticipantEmail</td>
                    <td>@item.Category</td>
                    <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (item.Status == "Confirmed")
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}