@model List<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="text-center mb-5">
    <h1 class="display-4 text-primary fw-bold">RaceDay Events</h1>
    <p class="lead">Find your next challenge and join the race!</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    @if (Model == null || Model.Count == 0)
    {
        <div class="col-12 text-center">
            <p class="text-muted">There are no upcoming events at the moment. Check back soon!</p>
        </div>
    }
    else
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    
                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                    {
                        <img src="https://localhost:7040@(ev.BannerUrl)" class="card-img-top" alt="@ev.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span>No Image</span>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@ev.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            <i class="bi bi-calendar"></i> @(ev.EventDate.Year > 1 ? ev.EventDate.ToString("dd MMM yyyy") : "Date TBA") 
                            | <i class="bi bi-geo-alt"></i> @ev.Location
                        </h6>
                        <p class="card-text flex-grow-1">@ev.Description</p>
                        <div class="mb-3">
                            <span class="badge bg-info text-dark">@ev.EventType</span>
                        </div>
                        
                        <a href="/Home/EventDetails/@ev.EventId" class="btn btn-primary w-100 mt-auto">View Event & Enrol</a>
                    </div>
                </div>
            </div>
        }
    }
</div>