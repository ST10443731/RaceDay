@model RaceDay.Web.Models.EventViewModel
@{
    ViewData["Title"] = Model?.Name ?? "Event Details";
    var categories = ViewBag.Categories as List<RaceDay.Web.Models.CategoryViewModel> ?? new List<RaceDay.Web.Models.CategoryViewModel>();
    var role = Context.Session.GetString("Role");
}

<div class="mb-4">
    <a href="/Home/Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Events</a>
</div>

<div class="card shadow-sm mb-4">
    @if (!string.IsNullOrEmpty(Model?.BannerUrl))
    {
        <img src="https://localhost:7040@(Model.BannerUrl)" class="card-img-top" alt="@Model.Name" style="max-height: 400px; object-fit: cover;">
    }
    
    <div class="card-body p-4">
        <h1 class="display-5 fw-bold">@Model?.Name</h1>
        <p class="text-muted fs-5">
            @(Model?.EventDate.Year > 1 ? Model.EventDate.ToString("dddd, dd MMMM yyyy") : "Date TBA") 
            | @Model?.Location
        </p>
        <hr />
        <p>@Model?.Description</p>
        <p><strong>Route Info:</strong> @Model?.RouteInfo</p>
        <span class="badge bg-primary fs-6">@Model?.EventType</span>
    </div>
</div>

<h3 class="mb-3">Available Categories</h3>

@if (categories.Count == 0)
{
    <div class="alert alert-info">No categories have been added to this event yet.</div>
}
else
{
    <div class="row">
        @foreach (var cat in categories)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@cat.Name</h5>
                        <p class="card-text mb-1"><strong>Distance:</strong> @cat.DistanceKm km</p>
                        <p class="card-text"><strong>Capacity:</strong> @cat.MaxParticipants participants</p>
                        
                        @if (role == "Participant")
                        {
                            <!-- The AntiForgeryToken is REQUIRED for POST forms -->
                            <form asp-controller="Participant" asp-action="Enrol" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                <button type="submit" class="btn btn-success w-100">Enrol Now</button>
                            </form>
                        }
                        else if (role == "Organiser" || role == "Organizer")
                        {
                            <span class="text-muted small">Organisers cannot enrol.</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}