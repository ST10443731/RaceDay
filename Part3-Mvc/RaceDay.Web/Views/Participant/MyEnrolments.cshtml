@model List<RaceDay.Web.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Enrolments</h2>
    <a href="/Home/Index" class="btn btn-primary">Find More Events</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <strong>API Error:</strong> @ViewBag.Error
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">You haven't enrolled in any events yet.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Category</th>
                <th>Distance</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Event</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@item.Category</td>
                    <td>@item.DistanceKm km</td>
                    <td>
                        @if (item.Status == "Confirmed")
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}